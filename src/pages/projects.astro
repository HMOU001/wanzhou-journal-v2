---
import Base from '../layouts/Base.astro';

const projects = [
  {
    tag: 'SIDE PROJECT',
    meta: '2024 — 至今 · 维护中',
    name: 'trail-notes',
    desc: '离线优先的徒步轨迹记录 PWA。无网可记、出山同步，轨迹与手记存在同一个 Markdown 文件里。为「山里三天不充电」的场景设计，运行时体积不到 300 KB。'
  },
  {
    tag: 'OPEN SOURCE',
    meta: '2025 · 稳定版',
    name: 'rss-reader-tui',
    desc: '终端里的 RSS 阅读器。Vim 键位，纯键盘操作，没有无限下拉。读完一篇，列表少一条——「全部已读」是它最重要的功能。'
  },
  {
    tag: 'THIS SITE',
    meta: '2023 — 至今 · 第 47 期',
    name: '晚舟手记',
    desc: '你现在读到的这本刊物。Astro 静态构建，两套设计系统：纸上杂志与蓝山夜色。源码公开，欢迎翻阅。'
  }
];
---
<Base title="专题" current="projects">
  <div class="mv-page mv-wrap">
    <div class="mv-page-head">
      <p class="kicker">PROJECTS</p>
      <h1>正在建造的东西</h1>
      <p class="lede">三个长期项目，进度缓慢但持续。原则相同：小、离线可用、不打扰。</p>
    </div>
    <div class="mv-grid-3">
      {projects.map(p => (
        <article class="mv-card">
          <span class="c-meta"><span class="mv-tag">{p.tag}</span><span>{p.meta}</span></span>
          <h3>{p.name}</h3>
          <p>{p.desc}</p>
        </article>
      ))}
    </div>
  </div>
</Base>
